<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Information -->
    <PackageId>MasLazu.AspNet.Authentication.Password.Domain</PackageId>
    <Version>1.0.0-preview.1</Version>
    <Authors>MasLazu</Authors>
    <Company>MasLazu</Company>
    <Description>Domain layer for MasLazu ASP.NET Password Authentication. Contains domain entities, business rules, and password hashing logic.</Description>
    <PackageTags>aspnetcore;authentication;password;domain;entities;business-rules</PackageTags>
    <RepositoryUrl>https://github.com/MasLazu/MasLazu.AspNet.Authentication.Password</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/MasLazu/MasLazu.AspNet.Authentication.Password</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MasLazu.AspNet.Framework.Domain" />
  </ItemGroup>

</Project>
