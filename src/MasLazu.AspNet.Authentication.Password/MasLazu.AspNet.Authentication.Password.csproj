<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Information -->
    <PackageId>MasLazu.AspNet.Authentication.Password</PackageId>
    <Version>1.0.0-preview.1</Version>
    <Authors>MasLazu</Authors>
    <Company>MasLazu</Company>
    <Description>Application layer for MasLazu ASP.NET Password Authentication. Contains service implementations, validation, and business logic.</Description>
    <PackageTags>aspnetcore;authentication;password;services;validation;business-logic</PackageTags>
    <RepositoryUrl>https://github.com/MasLazu/MasLazu.AspNet.Authentication.Password</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/MasLazu/MasLazu.AspNet.Authentication.Password</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MasLazu.AspNet.Authentication.Core.Abstraction" />
    <PackageReference Include="MasLazu.AspNet.Framework.Application" />
    <PackageReference Include="MasLazu.AspNet.Verification.Abstraction" />
    <PackageReference Include="BCrypt.Net-Next" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MasLazu.AspNet.Authentication.Password.Abstraction\MasLazu.AspNet.Authentication.Password.Abstraction.csproj" />
    <ProjectReference Include="..\MasLazu.AspNet.Authentication.Password.Domain\MasLazu.AspNet.Authentication.Password.Domain.csproj" />
  </ItemGroup>

</Project>
